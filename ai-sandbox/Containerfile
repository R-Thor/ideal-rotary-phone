# ============================
# Stage 1 — Build llama.cpp
# ============================
FROM ubuntu:22.04 AS builder

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        build-essential \
        git \
        cmake \
        wget \
        ca-certificates \
        libopenblas-dev \
        libomp-dev \
        libcurl4-openssl-dev \
        python3 && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /opt

# Clone llama.cpp
RUN git clone https://github.com/ggerganov/llama.cpp.git

WORKDIR /opt/llama.cpp

# Configure + build the server
RUN cmake -B build -S . -DLLAMA_BUILD_SERVER=ON
RUN cmake --build build --config Release -j
RUN ls -R /opt/llama.cpp/build/bin
RUN find / | grep -i bin$
# ============================
# Stage 2 — Runtime image
# ============================
FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y \
    wget \
    libcurl4 \
    && rm -rf /var/lib/apt/lists/*

# Create app directory
WORKDIR /app

# Copy server binary from builder stage
COPY --from=builder /opt/llama.cpp/build/bin/llama-server /opt/llama.cpp/server

# Copy entrypoint
COPY entrypoint.sh /app/entrypoint.sh
RUN chmod +x /app/entrypoint.sh

# Create models directory (host-mounted)
RUN mkdir -p /app/models

EXPOSE 8080


ENTRYPOINT ["/app/entrypoint.sh"]
